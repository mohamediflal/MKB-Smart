{
  "expo": {
    "name": "MKB Smart",
    "slug": "mkb-smart",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "scheme": "mkbsmart",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mkbsmart.app",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow MKB Smart to use speech recognition for voice search.",
        "NSMicrophoneUsageDescription": "Allow MKB Smart to use the microphone for voice search."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./src/assets/images/android-icon-foreground.png",
        "backgroundImage": "./src/assets/images/android-icon-background.png",
        "monochromeImage": "./src/assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.mkbsmart.app",
      "usesCleartextTraffic": true
    },
    "web": {
      "output": "static",
      "favicon": "./src/assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.mkbsmart",
          "enableGooglePay": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow MKB Smart to use the microphone for voice search.",
          "speechRecognitionPermission": "Allow MKB Smart to use speech recognition for voice search."
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8816a7c3-dec4-48f0-98b9-493f1579e5b7"
      }
    }
  }
}
